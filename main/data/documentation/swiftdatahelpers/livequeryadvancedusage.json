{"identifier":{"url":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryAdvancedUsage","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryTesting","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryPerformance","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/SwiftDataMigrations"],"title":"Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers"]]},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"SwiftDataHelpers"}],"title":"Live Query - Advanced Usage"},"variants":[{"paths":["\/documentation\/swiftdatahelpers\/livequeryadvancedusage"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Practical patterns for "},{"type":"reference","identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQuery","isActive":true},{"type":"text","text":" in complex SwiftData apps."}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide collects advanced patterns pulled from the SwiftDataHelpers example"},{"type":"text","text":" "},{"type":"text","text":"app. Use it when you need multiple containers, dynamic queries, or model-layer"},{"type":"text","text":" "},{"type":"text","text":"state that stays in sync with SwiftData."}]},{"anchor":"Multiple-Containers-and-Scoped-Queries","type":"heading","level":2,"text":"Multiple Containers and Scoped Queries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app uses more than one "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":", define them explicitly and"},{"type":"text","text":" "},{"type":"text","text":"scope queries to the correct store. A common pattern is to centralize container"},{"type":"text","text":" "},{"type":"text","text":"construction and select between them with an enum."}]},{"syntax":"swift","type":"codeListing","code":["enum Database {","    case main","    case privatePersons","","    var container: ModelContainer {","        switch self {","        case .main:","            .main","        case .privatePersons:","            .privatePersons","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a subtree should read from a non-default container, wrap it in"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable"},{"type":"text","text":" so "},{"type":"codeVoice","code":"@LiveQuery"},{"type":"text","text":" uses that container’s context."}]},{"syntax":"swift","type":"codeListing","code":["LiveQueryBindable(modelContainer: .privatePersons) {","    PrivatePeopleView()","}"]},{"anchor":"Dynamic-Predicates-and-Sorting","type":"heading","level":2,"text":"Dynamic Predicates and Sorting"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the predicate or sort order depends on view state, initialize the property"},{"type":"text","text":" "},{"type":"text","text":"wrapper in your view’s initializer so it stays consistent with the current"},{"type":"text","text":" "},{"type":"text","text":"inputs."}]},{"syntax":"swift","type":"codeListing","code":["struct FilteredPeopleList: View {","    private let filter: PersonFilter","    private let sort: PersonSort","","    @LiveQuery private var people: [Person]","","    init(filter: PersonFilter, sort: PersonSort) {","        self.filter = filter","        self.sort = sort","        _people = LiveQuery(predicate: filter.predicate, sort: sort.descriptors)","    }","","    var body: some View {","        ForEach(people) { person in","            Text(person.name)","        }","    }","}"]},{"anchor":"Using-LiveQuery-in-Observable-Models","type":"heading","level":2,"text":"Using LiveQuery in Observable Models"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LiveQuery"},{"type":"text","text":" also works in "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" models, which is useful when shared"},{"type":"text","text":" "},{"type":"text","text":"state belongs to a feature model instead of a view. Mark the property wrapper"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"@ObservationIgnored"},{"type":"text","text":" so the wrapper itself is not observed, while the"},{"type":"text","text":" "},{"type":"text","text":"backing data still updates when SwiftData saves. You can also consume"},{"type":"text","text":" "},{"type":"codeVoice","code":"$people.valuesStream"},{"type":"text","text":" for async snapshot handling. For UIKit view controllers,"},{"type":"text","text":" "},{"type":"text","text":"prefer "},{"type":"codeVoice","code":"LiveQueryViewController"},{"type":"text","text":" and "},{"type":"codeVoice","code":"LiveQueryViewController\/observe(_:onSnapshot:)"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Observable","final class PeopleFeatureModel {","    @ObservationIgnored","    @LiveQuery var people: [Person]","","    @ObservationIgnored","    private var valuesTask: Task<Void, Never>?","","    func observePeople() {","        valuesTask?.cancel()","        valuesTask = Task {","            for await snapshot in $people.valuesStream {","                print(\"People count: \\(snapshot.count)\")","            }","        }","    }","","    deinit {","        valuesTask?.cancel()","    }","}"]},{"anchor":"Multiple-LiveQuery-Streams-in-UIKit","type":"heading","level":2,"text":"Multiple LiveQuery Streams in UIKit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a UIKit screen needs several live queries, subclass"},{"type":"text","text":" "},{"type":"codeVoice","code":"LiveQueryViewController"},{"type":"text","text":" and register each projected query with"},{"type":"text","text":" "},{"type":"codeVoice","code":"LiveQueryViewController\/observe(_:onSnapshot:)"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import SwiftDataHelpers","import UIKit","","final class DashboardViewController: LiveQueryViewController {","    @LiveQuery(sort: [SortDescriptor(\\Person.name)]) private var people: [Person]","    @LiveQuery(sort: [SortDescriptor(\\Pet.name)]) private var pets: [Pet]","","    override func viewDidLoad() {","        super.viewDidLoad()","","        observe($people) { [weak self] snapshot in","            self?.updatePeople(snapshot)","        }","","        observe($pets) { [weak self] snapshot in","            self?.updatePets(snapshot)","        }","    }","}"]},{"anchor":"Background-Writes-with-ModelActor","type":"heading","level":2,"text":"Background Writes with @ModelActor"},{"type":"paragraph","inlineContent":[{"text":"When writes happen on a background model actor, ","type":"text"},{"type":"codeVoice","code":"@LiveQuery"},{"text":" still refreshes","type":"text"},{"text":" ","type":"text"},{"text":"because SwiftData posts save notifications on the container.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@ModelActor","actor PersonImporter {","    func importPeople(_ seeds: [PersonSeed]) throws {","        for seed in seeds {","            let person = Person(id: UUID(), name: seed.name, age: seed.age)","            modelContext.insert(person)","        }","","        try modelContext.save()","    }","}"]},{"type":"heading","text":"Environment-Specific Containers for Tests and Previews","level":2,"anchor":"Environment-Specific-Containers-for-Tests-and-Previews"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example app uses Dependencies "},{"type":"codeVoice","code":"context"},{"type":"text","text":" to build live containers in the app"},{"type":"text","text":" "},{"type":"text","text":"and in-memory containers for tests and previews. This keeps "},{"type":"codeVoice","code":"@LiveQuery"},{"type":"text","text":" fast"},{"text":" ","type":"text"},{"text":"and deterministic in non-live environments.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension ModelContainer {","    static let main: ModelContainer = {","        @Dependency(\\.context) var context","","        if context == .live {","            return try! ModelContainer(for: Schema([Person.self, Pet.self]))","        }","","        return makeTestContainer(name: \"main\")","    }()","","    private static func makeTestContainer(name: String) -> ModelContainer {","        try! ModelContainer(","            for: Schema([Person.self, Pet.self]),","            configurations: .init(name, isStoredInMemoryOnly: true)","        )","    }","}"]}],"kind":"content"}],"kind":"article","references":{"doc://SwiftDataHelpers/documentation/SwiftDataHelpers/LiveQueryPerformance":{"url":"\/documentation\/swiftdatahelpers\/livequeryperformance","kind":"article","identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryPerformance","title":"Live Query - Performance","abstract":[{"text":"Tips for keeping ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQuery","isActive":true,"type":"reference"},{"text":" fast and predictable in larger apps.","type":"text"}],"type":"topic","role":"article"},"doc://SwiftDataHelpers/documentation/SwiftDataHelpers/LiveQueryTesting":{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryTesting","type":"topic","title":"Live Query - Testing","url":"\/documentation\/swiftdatahelpers\/livequerytesting","abstract":[{"type":"text","text":"Guidance for testing "},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQuery","type":"reference","isActive":true},{"type":"text","text":"-powered featur