ependencies<T>(_ operation: () throws -> T) rethrows -> T {","    try withDependencies {","        $0.liveQueryContext.modelContext = { ModelContainer.main.mainContext }","    } operation: {","        try operation()","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Resetting-State-Between-Tests","text":"Resetting State Between Tests","type":"heading"},{"inlineContent":[{"text":"If you reuse containers across tests, delete existing data to keep each test","type":"text"},{"text":" ","type":"text"},{"text":"independent:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","private func deleteAll<M: PersistentModel>(","    in context: ModelContext,","    _ type: M.Type",") throws {","    let models = try context.fetch(FetchDescriptor<M>())","    for model in models {","        context.delete(model)","    }","    try context.save()","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"abstract":[{"text":"Guidance for testing ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQuery","isActive":true,"type":"reference"},{"text":"-powered features with deterministic","type":"text"},{"text":" ","type":"text"},{"text":"SwiftData stores and dependency overrides.","type":"text"}],"variants":[{"paths":["\/documentation\/swiftdatahelpers\/livequerytesting"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers"]]},"references":{"doc://SwiftDataHelpers/documentation/SwiftDataHelpers/LiveQueryAdvancedUsage":{"kind":"article","identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryAdvancedUsage","url":"\/documentation\/swiftdatahelpers\/livequeryadvancedusage","title":"Live Query - Advanced Usage","type":"topic","role":"article","abstract":[{"type":"text","text":"Practical patterns for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQue