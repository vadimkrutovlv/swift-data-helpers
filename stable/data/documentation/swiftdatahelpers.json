wift Package Manager","type":"heading","anchor":"Add-the-package-in-Swift-Package-Manager","level":3},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift","","dependencies: [","    .package(url: \"https:\/\/github.com\/vadimkrutovlv\/swift-data-helpers.git\", from: \"1.0.0\")","],","","targets: [","    .target(","        name: \"YourApp\",","        dependencies: [\"SwiftDataHelpers\"]","    )","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Update the version as new releases are published."}]},{"text":"Use SwiftDataHelpersMacros (optional)","type":"heading","anchor":"Use-SwiftDataHelpersMacros-optional","level":3},{"inlineContent":[{"text":"If you want generated model helpers (","type":"text"},{"code":"@CRUD","type":"codeVoice"},{"type":"text","text":", "},{"code":"@RelationshipQueries","type":"codeVoice"},{"type":"text","text":"), add the"},{"type":"text","text":" "},{"code":"SwiftDataHelpersMacros","type":"codeVoice"},{"type":"text","text":" product to the target where your "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" types are"},{"type":"text","text":" "},{"type":"text","text":"declared."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift","","targets: [","    .target(","        name: \"YourApp\",","        dependencies: [","            \"SwiftDataHelpers\",","            \"SwiftDataHelpersMacros\",","        ]","    )","]"]},{"type":"paragraph","inlineContent":[{"text":"Then import and annotate your models:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftData","import SwiftDataHelpersMacros","","@Model","@CRUD","@RelationshipQueries","final class Person {","    @Attribute(.unique) var id: UUID","    var name: String","    @Relationship(inverse: \\Pet.owner) var pets: [Pet]","}"]},{"type":"heading","level":2,"text":"Using LiveQuery","anchor":"Using-LiveQuery"},{"type":"paragraph","inlineContent":[{"code":"LiveQuery","type":"codeVoice"},{"text":" is a SwiftUI property wrapper that keeps your view state in sync","type":"text"},{"text":" ","type":"text"},{"text":"with SwiftData. It refreshes when the underlying model container saves, so your","type":"text"},{"text":" ","type":"text"},{"text":"lists and sections stay current without manual fetch logic.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It can be thought of as an alternative to SwiftData’s "},{"type":"codeVoice","code":"@Query"},{"type":"text","text":" macro, with"},{"type":"text","text":" "},{"type":"text","text":"explicit dependency-based context configuration."}]},{"inlineContent":[{"type":"text","text":"You can also use "},{"code":"@LiveQuery","type":"codeVoice"},{"type":"text","text":" in "},{"code":"@Observable","type":"codeVoice"},{"text":" models (for example, a feature","type":"text"},{"type":"text","text":" "},{"type":"text","text":"model that owns shared data) and any other main-actor-isolated type where you"},{"type":"text","text":" "},{"type":"text","text":"want live SwiftData-backed state."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When using "},{"type":"codeVoice","code":"@LiveQuery"},{"type":"text","text":" inside an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" model, mark the property"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"@ObservationIgnored"},{"type":"text","text":" to avoid conflicts with the Observation framework:"}]},{"type":"codeListing","syntax":"swift","code":["@Observable","final class MyFeatureModel {","    @ObservationIgnored","    @LiveQuery var items: [Item]","}"]}]},{"anchor":"Configure-the-ModelContext-primary","type":"heading","level":3,"text":"Configure the ModelContext (primary)"},{"type":"paragraph","inlineContent":[{"code":"@LiveQuery","type":"codeVoice"},{"type":"text","text":" relies on the Dependencies value "},{"code":"liveQueryContext.modelContext","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Configure it once at your app entry point so every view has a consistent source"},{"type":"text","text":" "},{"type":"text","text":"of truth. This is the recommended setup for most apps."}]},{"inlineContent":[{"type":"text","text":"If you do not already have a container, create a main container up front and"},{"type":"text","text":" "},{"text":"pass its ","type":"text"},{"type":"codeVoice","code":"mainContext"},{"text":" into the dependency:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import Dependencies","import SwiftData","import SwiftDataHelpers","import SwiftUI","","@main","struct MyApp: App {","    let container: ModelContainer = try! ModelContainer(","        for: Person.self","    )","","    init() {","        let container = self.container","        prepareDependencies {","            $0.liveQueryContext.modelContext = { container.mainContext }","        }","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .modelContainer(container)","        }","    }","}"]},{"type":"heading","level":3,"text":"Use @LiveQuery","anchor":"Use-LiveQuery"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LiveQuery"},{"type":"text","text":" keeps SwiftUI in sync with SwiftData by refreshing when the"},{"type":"text","text":" "},{"text":"underlying container saves. You can pass a predicate and sort descriptors to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"filter and order results."}]},{"type":"codeListing","syntax":"swift","code":["import SwiftDataHelpers","import SwiftUI","","struct PeopleList: View {","    @LiveQuery(","        predicate: #Predicate<Person> { $0.isActive },","        sort: [SortDescriptor(\\Person.name)]","    )","    private var people: [Person]","","    var body: some View {","        List(people) { person in","            Text(person.name)","        }","    }","}"]},{"anchor":"Consume-LiveQuery-as-AsyncStream","level":3,"text":"Consume LiveQuery as AsyncStream","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"$people.valuesStream"},{"text":" when you need async iteration over snapshots:","type":"text"},{"type":"text","text":" "},{"type":"text","text":"this pattern is primarily for non-UIKit types (for example, "},{"type":"codeVoice","code":"@Observable"},{"text":" ","type":"text"},{"text":"models). For UIKit controllers, prefer ","type":"text"},{"type":"codeVoice","code":"LiveQueryViewController"},{"text":" and","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"LiveQueryViewController\/observe(_:onSnapshot:)"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["@MainActor","@Observable","final class PeopleFeatureModel {","    @ObservationIgnored","    @LiveQuery(sort: [SortDescriptor(\\Person.name)])","    var people: [Person]","","    @ObservationIgnored","    private var valuesTask: Task<Void, Never>?","","    func observePeople() {","        valuesTask?.cancel()","        valuesTask = Task {","            for await snapshot in $people.valuesStream {","                print(\"People count: \\(snapshot.count)\")","            }","        }","    }","","    deinit {","        valuesTask?.cancel()","    }","}"],"syntax":"swift"},{"text":"Use LiveQuery in UIKit View Controllers","level":3,"type":"heading","anchor":"Use-LiveQuery-in-UIKit-View-Controllers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For UIKit screens, subclass "},{"code":"LiveQueryViewController","type":"codeVoice"},{"type":"text","text":" and register projected"},{"type":"text","text":" "},{"type":"text","text":"queries with "},{"code":"LiveQueryViewController\/observe(_:onSnapshot:)","type":"codeVoice"},{"type":"text","text":". The base class"},{"type":"text","text":" "},{"type":"text","text":"starts observation in "},{"type":"codeVoice","code":"viewDidAppear"},{"type":"text","text":" and stops it in "},{"type":"codeVoice","code":"viewDidDisappear"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["import SwiftDataHelpers","import UIKit","","final class PeopleViewController: LiveQueryViewController {","    @LiveQuery(sort: [SortDescriptor(\\Person.name)])","    private var people: [Person]","","    private var displayedPeople: [Person] = []","    private let tableView = UITableView(frame: .zero, style: .plain)","","    override func viewDidLoad() {","        super.viewDidLoad()","","        observe($people) { [weak self] snapshot in","            guard let self else { return }","            displayedPeople = snapshot","            tableView.reloadData()","        }","    }","}"]},{"text":"Multiple Containers (optional)","type":"heading","level":3,"anchor":"Multiple-Containers-optional"},{"type":"paragraph","inlineContent":[{"text":"If your app uses more than one ","type":"text"},{"code":"ModelContainer","type":"codeVoice"},{"text":" (for example, main and private","type":"text"},{"text":" ","type":"text"},{"text":"stores), use ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","type":"reference","isActive":true},{"text":" to scope queries to the desired container.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"This is ideal for subtrees of your UI that should read from a non-default"},{"type":"text","text":" "},{"type":"text","text":"container."}]},{"syntax":"swift","type":"codeListing","code":["LiveQueryBindable(modelContainer: .privatePersons) {","    PrivatePeopleView()","}"]},{"type":"heading","anchor":"Previews-and-Tests-optional","text":"Previews and Tests (optional)","level":3},{"type":"paragraph","inlineContent":[{"text":"For previews and tests, inject a ","type":"text"},{"code":"ModelContext","type":"codeVoice"},{"text":" directly. This keeps ","type":"text"},{"code":"@LiveQuery","type":"codeVoice"},{"text":" ","type":"text"},{"text":"functional without bootstrapping your full app lifecycle.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["#Preview {","    prepareDependencies {","        $0.liveQueryContext.modelContext = { ModelContainer.main.mainContext }","    }","","    return PeopleList()","        .modelContainer(.main)","}"]},{"anchor":"FAQ","text":"FAQ","type":"heading","level":2},{"anchor":"I-see-logs-about-liveQueryContextmodelContext-not-set-What-does-it-mean","text":"I see logs about `liveQueryContext.modelContext` not set. What does it mean?","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"code":"@LiveQuery","type":"codeVoice"},{"text":" requires a ","type":"text"},{"code":"ModelContext","type":"codeVoice"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/Dependencies\/DependencyValues\/liveQueryContext","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If this dependency is not configured, SwiftDataHelpers logs a fault and the","type":"text"},{"text":" ","type":"text"},{"text":"query returns empty results until a context is provided. Configure it once at","type":"text"},{"text":" ","type":"text"},{"text":"your app entry point with ","type":"text"},{"code":"prepareDependencies","type":"codeVoice"},{"type":"text","text":", or scope a subtree with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Can-I-use-LiveQuery-outside-of-views","text":"Can I use `@LiveQuery` outside of views?","level":3},{"type":"paragraph","inlineContent":[{"text":"Yes. It works in ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" models or other main-actor-isolated types. When"},{"type":"text","text":" "},{"type":"text","text":"used inside an observable model, mark the property wrapper with"},{"type":"text","text":" "},{"type":"codeVoice","code":"@ObservationIgnored"},{"type":"text","text":" to avoid conflicts with Observation."}]},{"text":"How do I query multiple containers?","type":"heading","level":3,"anchor":"How-do-I-query-multiple-containers"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","type":"reference","isActive":true},{"text":" to scope queries to a specific container, or override","type":"text"},{"text":" ","type":"text"},{"text":"the dependency for a particular subtree. The advanced guide shows patterns for","type":"text"},{"text":" ","type":"text"},{"text":"main\/private container setups.","type":"text"}]},{"text":"Is `@LiveQuery` a replacement for `@Query`?","type":"heading","level":3,"anchor":"Is-LiveQuery-a-replacement-for-Query"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is an alternative with explicit dependency-based context configuration. If"},{"type":"text","text":" "},{"type":"text","text":"you prefer SwiftData’s "},{"type":"codeVoice","code":"@Query"},{"type":"text","text":" macro, you can continue using it alongside this"},{"type":"text","text":" "},{"type":"text","text":"library."}]}]}],"hierarchy":{"paths":[[]]},"variants":[{"paths":["\/documentation\/swiftdatahelpers"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","references":{"doc://SwiftDataHelpers/documentation/SwiftDataHelpers":{"title":"SwiftDataHelpers","abstract":[{"text":"A growing set of SwiftData helpers for SwiftUI and app architecture.","type":"text"}],"url":"\/documentation\/swiftdatahelpers","ide