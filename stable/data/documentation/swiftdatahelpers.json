{"metadata":{"modules":[{"name":"SwiftDataHelpers"}],"role":"collection","symbolKind":"module","title":"SwiftDataHelpers","externalID":"SwiftDataHelpers","roleHeading":"Framework"},"abstract":[{"text":"A growing set of SwiftData helpers for SwiftUI and app architecture.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryAdvancedUsage","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryTesting","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryPerformance","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/SwiftDataMigrations"],"title":"Guides","anchor":"Guides"},{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/CRUDUsage","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/RelationshipQueriesUsage","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/MacrosPerformanceAndLimits"],"title":"Macros","anchor":"Macros"},{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQuery"],"title":"Live Queries","anchor":"Live-Queries"},{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/Dependencies\/DependencyValues\/liveQueryContext"],"title":"Dependency Setup","anchor":"Dependency-Setup"},{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/SwiftDataHelpersModelContext"],"title":"Structures","anchor":"Structures","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftDataHelpers is a small, focused package that collects convenience APIs for"},{"type":"text","text":" "},{"type":"text","text":"working with SwiftData in SwiftUI apps. The goal is to keep common patterns"},{"type":"text","text":" "},{"type":"text","text":"simple, re