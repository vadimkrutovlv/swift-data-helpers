{"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide collects advanced patterns pulled from the SwiftDataHelpers example","type":"text"},{"text":" ","type":"text"},{"text":"app. Use it when you need multiple containers, dynamic queries, or model-layer","type":"text"},{"text":" ","type":"text"},{"text":"state that stays in sync with SwiftData.","type":"text"}]},{"type":"heading","level":2,"anchor":"Multiple-Containers-and-Scoped-Queries","text":"Multiple Containers and Scoped Queries"},{"type":"paragraph","inlineContent":[{"text":"If your app uses more than one ","type":"text"},{"code":"ModelContainer","type":"codeVoice"},{"text":", define them explicitly and","type":"text"},{"text":" ","type":"text"},{"text":"scope queries to the correct store. A common pattern is to centralize container","type":"text"},{"text":" ","type":"text"},{"text":"construction and select between them with an enum.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["enum Database {","    case main","    case privatePersons","","    var container: ModelContainer {","        switch self {","        case .main:","            .main","        case .privatePersons:","            .privatePersons","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"When a subtree should read from a non-default container, wrap it in","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","type":"reference"},{"text":" so ","type":"text"},{"code":"@LiveQuery","type":"codeVoice"},{"text":" uses that container’s context.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LiveQueryBindable(modelContainer: .privatePersons) {","    PrivatePeopleView()","}"]},{"type":"heading","level":2,"anchor":"Dynamic-Predicates-and-Sorting","text":"Dynamic Predicates and Sorting"},{"type":"paragraph","inlineContent":[{"text":"When the predicate or sort order depends on view state, initialize the property","type":"text"},{"text":" ","type":"text"},{"text":"wrapper in your view’s initializer so it stays consistent with the current","type":"text"},{"text":" ","type":"text"},{"text":"inputs.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct FilteredPeopleList: View {","    private let filter: PersonFilter","    private let sort: PersonSort","","    @LiveQuery private var people: [Person]","","    init(filter: PersonFilter, sort: PersonSort) {","        self.filter = filter","        self.sort = sort","        _people = LiveQuery(predicate: filter.predicate, sort: sort.descriptors)","    }","","    var body: some View {","        ForEach(people) { person in","            Text(person.name)","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Using-LiveQuery-in-Observable-Models","text":"Using LiveQuery in Observable Models"},{"type":"paragraph","inlineContent":[{"code":"@LiveQuery","type":"codeVoice"},{"text":" also works in ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" models, which is useful when shared","type":"text"},{"text":" ","type":"text"},{"text":"state belongs to a feature model instead of a view. Mark the property wrapper","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"@ObservationIgnored","type":"codeVoice"},{"text":" so the wrapper itself is not observed, while the","type":"text"},{"text":" ","type":"text"},{"text":"backing data still updates when SwiftData saves. You can also consume","type":"text"},{"text":" ","type":"text"},{"code":"$people.valuesStream","type":"codeVoice"},{"text":" for async snapshot handling. For UIKit view controllers,","type":"text"},{"text":" ","type":"text"},{"text":"prefer ","type":"text"},{"code":"LiveQueryViewController","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"LiveQueryViewController\/observe(_:onSnapshot:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Observable","final class PeopleFeatureModel {","    @ObservationIgnored","    @LiveQuery var people: [Person]","","    @ObservationIgnored","    private var valuesTask: Task<Void, Never>?","","    func observePeople() {","        valuesTask?.cancel()","        valuesTask = Task {","            for await snapshot in $people.valuesStream {","                print(\"People count: \\(snapshot.count)\")","            }","        }","    }","","    deinit {","        valuesTask?.cancel()","    }","}"]},{"type":"heading","level":2,"anchor":"Multiple-LiveQuery-Streams-in-UIKit","text":"Multiple LiveQuery Streams in UIKit"},{"type":"paragraph","inlineContent":[{"text":"When a UIKit screen needs several live queries, subclass","type":"text"},{"text":" ","type":"text"},{"code":"LiveQueryViewController","type":"codeVoice"},{"text":" and register each projected query with","type":"text"},{"text":" ","type":"text"},{"code":"LiveQueryViewController\/observe(_:onSnapshot:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiftDataHelpers","import UIKit","","final class DashboardViewController: LiveQueryViewController {","    @LiveQuery(sort: [SortDescriptor(\\Person.name)]) private var people: [Person]","    @LiveQuery(sort: [SortDescriptor(\\Pet.name)]) private var pets: [Pet]","","    override func viewDidLoad() {","        super.viewDidLoad()","","        observe($people) { [weak self] snapshot in","            self?.updatePeople(snapshot)","        }","","        observe($pets) { [weak self] snapshot in","            self?.updatePets(snapshot)","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Background-Writes-with-ModelActor","text":"Background Writes with @ModelActor"},{"type":"paragraph","inlineContent":[{"text":"When writes happen on a background model actor, ","type":"text"},{"code":"@LiveQuery","type":"codeVoice"},{"text":" still refreshes","type":"text"},{"text":" ","type":"text"},{"text":"because SwiftData posts save notifications on the container.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@ModelActor","actor PersonImporter {","    func importPeople(_ seeds: [PersonSeed]) throws {","        for seed in seeds {","            let person = Person(id: UUID(), name: seed.name, age: seed.age)","            modelContext.insert(person)","        }","","        try modelContext.save()","    }","}"]},{"type":"heading","level":2,"anchor":"Environment-Specific-Containers-for-Tests-and-Previews","text":"Environment-Specific Containers for Tests and Previews"},{"type":"paragraph","inlineContent":[{"text":"The example app uses Dependencies ","type":"text"},{"code":"context","type":"codeVoice"},{"text":" to build live containers in the app","type":"text"},{"text":" ","type":"text"},{"text":"and in-memory containers for tests and previews. This keeps ","type":"text"},{"code":"@LiveQuery","type":"codeVoice"},{"text":" fast","type":"text"},{"text":" ","type":"text"},{"text":"and deterministic in non-live environments.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension ModelContainer {","    static let main: ModelContainer = {","        @Dependency(\\.context) var context","","        if context == .live {","            return try! ModelContainer(for: Schema([Person.self, Pet.self]))","        }","","        return makeTestContainer(name: \"main\")","    }()","","    private static func makeTestContainer(name: String) -> ModelContainer {","        try! ModelContainer(","            for: Schema([Person.self, Pet.self]),","            configurations: .init(name, isStoredInMemoryOnly: true)","        )","    }","}"]}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryTesting","doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers