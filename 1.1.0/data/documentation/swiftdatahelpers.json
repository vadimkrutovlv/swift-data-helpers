{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"SwiftDataHelpers is a small, focused package that collects convenience APIs for","type":"text"},{"text":" ","type":"text"},{"text":"working with SwiftData in SwiftUI apps. The goal is to keep common patterns","type":"text"},{"text":" ","type":"text"},{"text":"simple, readable, and testable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Today the library focuses on live SwiftUI queries powered by","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"swift-dependencies"},{"text":", and it will expand with more helpers over time as new","type":"text"},{"text":" ","type":"text"},{"text":"needs appear.","type":"text"}]},{"anchor":"Requirements","level":2,"text":"Requirements","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"iOS 17, macOS 14, watchOS 10, tvOS 17, visionOS 2","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Swift tools version 6.2","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"SwiftData (Apple framework, available on the platforms above)","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Dependencies","level":2,"text":"Dependencies","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"https:\/\/github.com\/pointfreeco\/swift-dependencies","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"SwiftData (Apple framework)","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Get-Started","level":2,"text":"Get Started","type":"heading"},{"anchor":"Add-the-package-in-Xcode","level":3,"text":"Add the package in Xcode","type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Open your project in Xcode and choose File > Add Packages.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Enter ","type":"text"},{"code":"https:\/\/github.com\/vadimkrutovlv\/swift-data-helpers.git","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the ","type":"text"},{"code":"SwiftDataHelpers","type":"codeVoice"},{"text":" product and add it to your target.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Add-the-package-in-Swift-Package-Manager","level":3,"text":"Add the package in Swift Package Manager","type":"heading"},{"syntax":"swift","type":"codeListing","code":["\/\/ Package.swift","","dependencies: [","    .package(url: \"https:\/\/github.com\/vadimkrutovlv\/swift-data-helpers.git\", from: \"1.0.0\")","],","","targets: [","    .target(","        name: \"YourApp\",","        dependencies: [\"SwiftDataHelpers\"]","    )","]"]},{"type":"paragraph","inlineContent":[{"text":"Update the version as new releases are published.","type":"text"}]},{"anchor":"Use-SwiftDataHelpersMacros-optional","level":3,"text":"Use SwiftDataHelpersMacros (optional)","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If you want generated model helpers (","type":"text"},{"type":"codeVoice","code":"@CRUD"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@RelationshipQueries"},{"text":"), add the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiftDataHelpersMacros"},{"text":" product to the target where your ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" types are","type":"text"},{"text":" ","type":"text"},{"text":"declared.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Package.swift","","targets: [","    .target(","        name: \"YourApp\",","        dependencies: [","            \"SwiftDataHelpers\",","            \"SwiftDataHelpersMacros\",","        ]","    )","]"]},{"type":"paragraph","inlineContent":[{"text":"Then import and annotate your models:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftData","import SwiftDataHelpersMacros","","@Model","@CRUD","@RelationshipQueries","final class Person {","    @Attribute(.unique) var id: UUID","    var name: String","    @Relationship(inverse: \\Pet.owner) var pets: [Pet]","}"]},{"anchor":"Using-LiveQuery","level":2,"text":"Using LiveQuery","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LiveQuery"},{"text":" is a SwiftUI property wrapper that keeps your view state in sync","type":"text"},{"text":" ","type":"text"},{"text":"with SwiftData. It refreshes when the underlying model container saves, so your","type":"text"},{"text":" ","type":"text"},{"text":"lists and sections stay current without manual fetch logic.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It can be thought of as an alternative to SwiftData’s ","type":"text"},{"type":"codeVoice","code":"@Query"},{"text":" macro, with","type":"text"},{"text":" ","type":"text"},{"text":"explicit dependency-based context configuration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You can also use ","type":"text"},{"type":"codeVoice","code":"@LiveQuery"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" models (for example, a feature","type":"text"},{"text":" ","type":"text"},{"text":"model that owns shared data) and any other main-actor-isolated type where you","type":"text"},{"text":" ","type":"text"},{"text":"want live SwiftData-backed state.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"text":"When using ","type":"text"},{"code":"@LiveQuery","type":"codeVoice"},{"text":" inside an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" model, mark the property","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"code":"@ObservationIgnored","type":"codeVoice"},{"text":" to avoid conflicts with the Observation framework:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Observable","final class MyFeatureModel {","    @ObservationIgnored","    @LiveQuery var items: [Item]","}"]}],"name":"Note","type":"aside"},{"anchor":"Configure-the-ModelContext-primary","level":3,"text":"Configure the ModelContext (primary)","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LiveQuery"},{"text":" relies on the Dependencies value ","type":"text"},{"type":"codeVoice","code":"liveQueryContext.modelContext"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Configure it once at your app entry point so every view has a consistent source","type":"text"},{"text":" ","type":"text"},{"text":"of truth. This is the recommended setup for most apps.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you do not already have a container, create a main container up front and","type":"text"},{"text":" ","type":"text"},{"text":"pass its ","type":"text"},{"type":"codeVoice","code":"mainContext"},{"text":" into the dependency:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Dependencies","import SwiftData","import SwiftDataHelpers","import SwiftUI","","@main","struct MyApp: App {","    let container: ModelContainer = try! ModelContainer(","        for: Person.self","    )","","    init() {","        let container = self.container","        prepareDependencies {","            $0.liveQueryContext.modelContext = { container.mainContext }","        }","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .modelContainer(container)","        }","    }","}"]},{"anchor":"Use-LiveQuery","level":3,"text":"Use @LiveQuery","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LiveQuery"},{"text":" keeps SwiftUI in sync with SwiftData by refreshing when the","type":"text"},{"text":" ","type":"text"},{"text":"underlying container saves. You can pass a predicate and sort descriptors to","type":"text"},{"text":" ","type":"text"},{"text":"filter and order results.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftDataHelpers","import SwiftUI","","struct PeopleList: View {","    @LiveQuery(","        predicate: #Predicate<Person> { $0.isActive },","        sort: [SortDescriptor(\\Person.name)]","    )","    private var people: [Person]","","    var body: some View {","        List(people) { person in","            Text(person.name)","        }","    }","}"]},{"anchor":"Consume-LiveQuery-as-AsyncStream","level":3,"text":"Consume LiveQuery as AsyncStream","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"$people.valuesStream"},{"text":" when you need async iteration over snapshots:","type":"text"},{"text":" ","type":"text"},{"text":"this pattern is primarily for non-UIKit types (for example, ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" ","type":"text"},{"text":"models). For UIKit controllers, prefer ","type":"text"},{"type":"codeVoice","code":"LiveQueryViewController"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LiveQueryViewController\/observe(_:onSnapshot:)"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Observable","final class PeopleFeatureModel {","    @ObservationIgnored","    @LiveQuery(sort: [SortDescriptor(\\Person.name)])","    var people: [Person]","","    @ObservationIgnored","    private var valuesTask: Task<Void, Never>?","","    func observePeople() {","        valuesTask?.cancel()","        valuesTask = Task {","            for await snapshot in $people.valuesStream {","                print(\"People count: \\(snapshot.count)\")","            }","        }","    }","","    deinit {","        valuesTask?.cancel()","    }","}"]},{"anchor":"Use-LiveQuery-in-UIKit-View-Controllers","level":3,"text":"Use LiveQuery in UIKit View Controllers","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For UIKit screens, subclass ","type":"text"},{"type":"codeVoice","code":"LiveQueryViewController"},{"text":" and register projected","type":"text"},{"text":" ","type":"text"},{"text":"queries with ","type":"text"},{"type":"codeVoice","code":"LiveQueryViewController\/observe(_:onSnapshot:)"},{"text":". The base class","type":"text"},{"text":" ","type":"text"},{"text":"starts observation in ","type":"text"},{"type":"codeVoice","code":"viewDidAppear"},{"text":" and stops it in ","type":"text"},{"type":"codeVoice","code":"viewDidDisappear"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiftDataHelpers","import UIKit","","final class PeopleViewController: LiveQueryViewController {","    @LiveQuery(sort: [SortDescriptor(\\Person.name)])","    private var people: [Person]","","    private var displayedPeople: [Person] = []","    private let tableView = UITableView(frame: .zero, style: .plain)","","    override func viewDidLoad() {","        super.viewDidLoad()","","        observe($people) { [weak self] snapshot in","            guard let self else { return }","            displayedPeople = snapshot","            tableView.reloadData()","        }","    }","}"]},{"anchor":"Multiple-Containers-optional","level":3,"text":"Multiple Containers (optional)","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If your app uses more than one ","type":"text"},{"type":"codeVoice","code":"ModelContainer"},{"text":" (for example, main and private","type":"text"},{"text":" ","type":"text"},{"text":"stores), use ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","type":"reference","isActive":true},{"text":" to scope queries to the desired container.","type":"text"},{"text":" ","type":"text"},{"text":"This is ideal for subtrees of your UI that should read from a non-default","type":"text"},{"text":" ","type":"text"},{"text":"container.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["LiveQueryBindable(modelContainer: .privatePersons) {","    PrivatePeopleView()","}"]},{"anchor":"Previews-and-Tests-optional","level":3,"text":"Previews and Tests (optional)","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For previews and tests, inject a ","type":"text"},{"type":"codeVoice","code":"ModelContext"},{"text":" directly. This keeps ","type":"text"},{"type":"codeVoice","code":"@LiveQuery"},{"text":" ","type":"text"},{"text":"functional without bootstrapping your full app lifecycle.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["#Preview {","    prepareDependencies {","        $0.liveQueryContext.modelContext = { ModelContainer.main.mainContext }","    }","","    return PeopleList()","        .modelContainer(.main)","}"]},{"anchor":"FAQ","level":2,"text":"FAQ","type":"heading"},{"anchor":"I-see-logs-about-liveQueryContextmodelContext-not-set-What-does-it-mean","level":3,"text":"I see logs about `liveQueryContext.modelContext` not set. What does it mean?","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@LiveQuery"},{"text":" requires a ","type":"text"},{"type":"codeVoice","code":"ModelContext"},{"text":" from","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/Dependencies\/DependencyValues\/liveQueryContext","type":"reference","isActive":true},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If this dependency is not configured, SwiftDataHelpers logs a fault and the","type":"text"},{"text":" ","type":"text"},{"text":"query returns empty results until a context is provided. Configure it once at","type":"text"},{"text":" ","type":"text"},{"text":"your app entry point with ","type":"text"},{"type":"codeVoice","code":"prepareDependencies"},{"text":", or scope a subtree with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"Can-I-use-LiveQuery-outside-of-views","level":3,"text":"Can I use `@LiveQuery` outside of views?","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Yes. It works in ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" models or other main-actor-isolated types. When","type":"text"},{"text":" ","type":"text"},{"text":"used inside an observable model, mark the property wrapper with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@ObservationIgnored"},{"text":" to avoid conflicts with Observation.","type":"text"}]},{"anchor":"How-do-I-query-multiple-containers","level":3,"text":"How do I query multiple containers?","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryBindable","type":"reference","isActive":true},{"text":" to scope queries to a specific container, or override","type":"text"},{"text":" ","type":"text"},{"text":"the dependency for a particular subtree. The advanced guide shows patterns for","type":"text"},{"text":" ","type":"text"},{"text":"main\/private container setups.","type":"text"}]},{"anchor":"Is-LiveQuery-a-replacement-for-Query","level":3,"text":"Is `@LiveQuery` a replacement for `@Query`?","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"It is an alternative with explicit dependency-based context configuration. If","type":"text"},{"text":" ","type":"text"},{"text":"you prefer SwiftData’s ","type":"text"},{"type":"codeVoice","code":"@Query"},{"text":" macro, you can continue using it alongside this","type":"text"},{"text":" ","type":"text"},{"text":"library.","type":"text"}]}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/SwiftDataHelpers\/documentation\/SwiftDataHelpers\/LiveQueryAdvancedUsag